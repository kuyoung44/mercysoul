# MercySoul OS production environment
NODE_ENV=production
PORT=10000

# Required for protected admin endpoints
ADMIN_API_TOKEN=generate-a-long-random-secret

# Gemini API — set ONLY in Vercel Environment Variables. Never commit the real key.
GEMINI_API_KEY=replace-with-secret
GEMINI_MODEL=gemini-2.5-flash

# Vercel Firewall rate-limit rule ID for /api/chat. Configure the rule in Vercel Firewall.
VERCEL_RATE_LIMIT_ID=chat-production
VERCEL_RATE_LIMIT_FAIL_CLOSED=false

# Local defense-in-depth controls
CHAT_RATE_WINDOW_MS=60000
CHAT_RATE_MAX_REQUESTS=10
CHAT_BURST_WINDOW_MS=10000
CHAT_BURST_MAX_REQUESTS=3
CHAT_VIOLATION_LIMIT=3
CHAT_BLOCK_MS=900000
CHAT_MAX_MESSAGE_LENGTH=4000
ALLOWED_ORIGINS=https://mercysoul.vercel.app

# Eye Lens / Gaze API protection
GAZE_API_KEY=generate-a-long-random-secret

# Durable Supabase persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-secret
REQUIRE_DURABLE_PERSISTENCE=true

# Paystack webhook verification
PAYSTACK_SECRET_KEY=replace-with-secret

# Google OAuth — set real values only in deployment environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mercysoul-os.onrender.com/api/auth/google/callback
# GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/gmail.readonly
