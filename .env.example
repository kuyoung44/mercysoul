# MercySoul OS production environment
NODE_ENV=production
PORT=10000

# Required for protected admin endpoints
ADMIN_API_TOKEN=generate-a-long-random-secret

# Eye Lens / Gaze API protection
# Set this ONLY in the deployment provider's secret/environment settings.
# Never commit the real value to GitHub.
GAZE_API_KEY=generate-a-long-random-secret

# Durable Supabase persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-secret
REQUIRE_DURABLE_PERSISTENCE=true

# Paystack webhook verification
PAYSTACK_SECRET_KEY=replace-with-secret

# Google OAuth — set real values only in Render Environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mercysoul-os.onrender.com/api/auth/google/callback
# Default: openid email profile. Add Gmail readonly only after enabling the Gmail API and completing Google's consent/verification requirements.
# GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/gmail.readonly

# Optional approved protocol feed controls
# PROTOCOL_SOURCE_URL=https://raw.githubusercontent.com/kuyoung44/mercysoul/main/protocol-feed.json
# PROTOCOL_REFRESH_HOURS=6
